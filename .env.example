# Salin ke .env.local lalu isi. Nilai diambil dari Supabase Dashboard → Project Settings → API Keys.
# Kunci legacy (anon / service_role) juga bisa dipakai di variabel yang sama.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Rahasia server: melewati RLS. Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Cloudflare R2 (Dashboard → R2 → Manage API tokens → token dengan izin Object Read & Write untuk bucket ini).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Kunci HMAC token sesi kamera tamu, minimal 32 karakter acak. Buat dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GUEST_SESSION_SECRET=

# Midtrans (Dashboard → Settings → Access Keys). Pakai kunci Sandbox selama pengembangan.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Opsional. Domain utama aplikasi (dipisah koma), mis. momenkita.id,www.momenkita.id. Host lain dianggap
# custom domain Luxury dan diarahkan ke undangan event-nya. localhost dan *.vercel.app selalu dianggap domain utama.
PRIMARY_HOSTS=

# Opsional. Error tracking Sentry (https://sentry.io). Tanpa DSN, pelaporan error mati dan aplikasi tetap jalan.
# DSN boleh publik (dipakai browser). Tiga variabel SENTRY_* di bawah hanya untuk mengunggah source map saat build;
# isi di Vercel saja, bukan di .env.local.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
